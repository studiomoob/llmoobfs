* text=auto eol=lf
*.png binary
*.jpg binary
*.img binary
*.ko binary
# ADR-0041: the apt index is apt-ftparchive output, hashed by the signed Release; it must stay byte for byte
site/apt/dists/** -whitespace -text
# console captures of the kernel, kept as printed: an empty report line is a timestamp and a space
tests/kdiag/*.txt -whitespace
