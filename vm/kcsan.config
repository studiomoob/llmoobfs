# Kernel configuration fragment for the KCSAN run (security roadmap S8, journal 0114): the
# KASAN fragment with the memory detectors replaced by the data-race detector, which cannot be
# built together with KASAN (Documentation/dev-tools/kcsan.rst). Lockdep stays.
CONFIG_PROVE_LOCKING=y
CONFIG_LOCKDEP=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_PLIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_PROVE_RCU=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_VM=y
CONFIG_PANIC_ON_OOPS=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FS_IOMAP=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_LIBCRC32C=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_LOG_WRITES=y
CONFIG_DM_FLAKEY=y
CONFIG_FILE_LOCKING=y
CONFIG_FS_VERITY=n
CONFIG_OVERLAY_FS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_FS_POSIX_ACL=y
CONFIG_DEBUG_FS=y
CONFIG_STACKTRACE=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAULT_INJECTION_STACKTRACE_FILTER=y
CONFIG_KCSAN=y
CONFIG_KCSAN_STRICT=n
CONFIG_KCSAN_REPORT_VALUE_CHANGE_ONLY=y
CONFIG_KCSAN_INTERRUPT_WATCHER=y
