# Additions to vm/kasan.config for an s390x host (vm/kasan-local.sh, journal 0280), applied after
# it; an x86-64 build does not read this file. Every line is a difference from the x86-64 kernel.
# KVM host support is not needed inside the guest, and arch/s390/kvm of 6.12.116 does not build:
# kvm-s390.c:4776 calls __kvm_faultin_pfn(), and :4786 and :4806 use KVM_PFN_ERR_NEEDS_IO and
# kvm_release_faultin_page(), which this stable release does not declare.
CONFIG_KVM=n
