# Kernel configuration fragment for the interoperability probe (vm/interop-guest.sh,
# .github/workflows/interop.yml): a plain kernel, no sanitizers, enough for an ext4 lower
# and the layer module. Applied by virtme-ng on top of its minimal boot configuration.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLOCK=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_UNICODE=y
CONFIG_FILE_LOCKING=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_LIBCRC32C=y
