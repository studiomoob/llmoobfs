#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
/bin/busybox --install -s /bin
export PATH=/bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /mnt/moob /tmp
chmod 0755 / && chmod 1777 /tmp   # the cpio root inherits mktemp 0700; unprivileged test users must traverse it
fail() { echo "MOOBFS_VM_FAIL: $*"; dmesg | tail -60; poweroff -f; sleep 60; }
insmod /loop.ko || fail loop
# Phase 1, the read-only M1 module (kernel/). It is not ported to 7.3 (ADR-0034 covers the
# layer only), so vm/in-container.sh leaves it out of a 7.3 guest's initramfs (journal 0275).
if [ -f /moobfs.ko ]; then
insmod /moobfs.ko || fail module
mount -t moobfs -o loop,ro /data/shared.img /mnt/moob || fail mount
/mounted /data/expected.bin || fail reads
mount -o remount,rw /mnt/moob && fail writable-remount
umount /mnt/moob || fail unmount
mount -t moobfs -o loop,ro /data/shared.img /mnt/moob || fail remount
/mounted /data/expected.bin || fail repeated-reads
umount /mnt/moob || fail second-unmount
device=$(losetup -f) || fail free-loop
losetup "$device" /data/shared.img || fail loop-attach
/mounted --reject-rw "$device" || fail writable-mount
losetup -d "$device" || fail loop-detach
mount -t moobfs -o loop,ro /data/edges.img /mnt/moob || fail edge-mount
[ "$(wc -c < /mnt/moob/empty)" -eq 0 ] || fail empty
[ "$(cat /mnt/moob/tiny)" = x ] || fail tiny
[ "$(wc -c < /mnt/moob/maximum)" -eq 65536 ] || fail maximum
cmp /mnt/moob/maximum /data/source-2 || fail maximum-content
umount /mnt/moob || fail edge-unmount
count=0
for image in /data/bad-*.img; do
    mount -t moobfs -o loop,ro "$image" /mnt/moob && fail "accepted $image"
    count=$((count + 1))
done
[ "$count" -eq 15 ] || fail "bad fixture count $count"
rmmod moobfs || fail unload
if dmesg | grep -E 'BUG:|Oops:|\] WARNING:|^WARNING:|Kernel panic|KASAN:'; then fail kernel-diagnostic; fi
echo "MOOBFS_VM_PASS: shared extents, independent inodes, reads, readonly, remount, 15 malformed images"
else
echo "MOOBFS_VM_SKIPPED: the M1 module is not built for $(uname -r)"
fi

# Layer phases 2a-2e: shared suite, with binaries in the initramfs root and lower
# filesystems on the virtio disks prepared by vm/in-container.sh.
BIN=/ TOOLS=/tools MODS=/mods DEV_EXT4=/dev/vda DEV_BTRFS=/dev/vdb DEV_XFS=/dev/vdc DEV_SCRATCH=/dev/vdd DEV_LOG=/dev/vde
export BIN TOOLS MODS DEV_EXT4 DEV_BTRFS DEV_XFS DEV_SCRATCH DEV_LOG
# moob_only=a,b on the kernel command line: run only those suite steps (see vm/suite.sh)
MOOB_ONLY=$(sed -n 's/.*moob_only=\([a-z0-9,]*\).*/\1/p' /proc/cmdline | tr ',' ' ')
export MOOB_ONLY
# moob_permchurn=SEEDS,STEPS[,FIRST]: a longer permchurn run (vm/suite.sh, journal 0250)
MOOB_PERMCHURN=$(sed -n 's/.*moob_permchurn=\([0-9,]*\).*/\1/p' /proc/cmdline)
export MOOB_PERMCHURN
# moob_selfcheck=1: the whole suite with the index self-check on (S16, journal 0271)
MOOB_SELFCHECK=$(sed -n 's/.*moob_selfcheck=\([01]\).*/\1/p' /proc/cmdline)
export MOOB_SELFCHECK
MOOB_EXPECT_MEMCG=1 # the pinned Debian guest has CONFIG_MEMCG=y
export MOOB_EXPECT_MEMCG
. /suite.sh
poweroff -f
