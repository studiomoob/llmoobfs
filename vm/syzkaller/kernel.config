# Kernel configuration fragment for fuzzing the layer with syzkaller (security roadmap S3,
# journal 0109). Merged by vm/syzkaller-local.sh on top of defconfig, kvm_guest.config and
# vm/kasan.config. Options from syzkaller's docs/linux/kernel_configs.md.
# coverage, the fuzzer's guide
CONFIG_KCOV=y
CONFIG_KCOV_INSTRUMENT_ALL=y
CONFIG_KCOV_ENABLE_COMPARISONS=y
CONFIG_DEBUG_FS=y
# symbolization and the coverage report
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
# the Debian image of tools/create-image.sh
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="net.ifnames=0"
# a fixed layout, for reproducible reports
# CONFIG_RANDOMIZE_BASE is not set
# sandboxing of the executor
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
# fault injection, which syzkaller drives per call
CONFIG_FAULT_INJECTION_USERCOPY=y
CONFIG_FAIL_FUTEX=y
# hangs, a class the layer has had (journal 0105)
CONFIG_LOCKUP_DETECTOR=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=140
CONFIG_RCU_CPU_STALL_TIMEOUT=100
CONFIG_WQ_WATCHDOG=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
# the executor works in a tmpfs root; user.* attributes there need this
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
