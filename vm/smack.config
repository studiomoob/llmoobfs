# Smack run of the layer (journal 0294): added to vm/kasan.config, so the run also has KASAN,
# UBSAN and lockdep. Smack is the only major LSM built and active; SELinux and AppArmor, which
# like Smack are exclusive majors, are left out. CONFIG_EXT4_FS_SECURITY stores security.SMACK64
# on the lower; CONFIG_SECURITY_NETWORK and CONFIG_INET are Smack's dependencies.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_INET=y
CONFIG_SECURITY_SMACK=y
CONFIG_SECURITY_SELINUX=n
CONFIG_SECURITY_APPARMOR=n
CONFIG_DEFAULT_SECURITY_SMACK=y
CONFIG_LSM="landlock,lockdown,yama,smack,bpf"
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
