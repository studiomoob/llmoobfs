# Kernel configuration fragment for fstests over the layer on a kernel built from source
# (vm/fstests-local.sh with MOOB_KDIR, journal 0275): vm/kasan.config without the detectors and
# the hardening options, which would only slow the run; the filesystems, ACLs, device-mapper
# targets and fault injection that fstests uses stay.
CONFIG_PANIC_ON_OOPS=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
# casefolded lower directories (issue #95, step casefold)
CONFIG_UNICODE=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FS_IOMAP=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_LIBCRC32C=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_LOG_WRITES=y
CONFIG_DM_FLAKEY=y
CONFIG_FILE_LOCKING=y
CONFIG_FS_VERITY=n
CONFIG_OVERLAY_FS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_FS_POSIX_ACL=y
# Fault injection confined to the module by the stack-trace filter (journal 0096;
# Documentation/fault-injection/fault-injection.rst). Nothing fails unless a test arms it.
CONFIG_DEBUG_FS=y
CONFIG_STACKTRACE=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAULT_INJECTION_STACKTRACE_FILTER=y
# quotas, which fstests' quota tests need and Debian's kernels have
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y
CONFIG_XFS_QUOTA=y
