# Kernel configuration fragment for the KASAN/lockdep harness (vm/kasan-guest.sh).
# Applied by virtme-ng on top of its minimal boot configuration.
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y
CONFIG_KASAN_VMALLOC=y
CONFIG_UBSAN=y
CONFIG_UBSAN_BOUNDS=y
CONFIG_PROVE_LOCKING=y
CONFIG_LOCKDEP=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_PLIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_PROVE_RCU=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_VM=y
CONFIG_PANIC_ON_OOPS=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_BLOCK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_VIRTIO_BLK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
# casefolded lower directories (issue #95, step casefold)
CONFIG_UNICODE=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_XFS_FS=y
CONFIG_XFS_POSIX_ACL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_FS_IOMAP=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_LIBCRC32C=y
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_LOG_WRITES=y
CONFIG_DM_FLAKEY=y
CONFIG_FILE_LOCKING=y
CONFIG_FS_VERITY=n
CONFIG_OVERLAY_FS=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_FS_POSIX_ACL=y
# Fault injection confined to the module by the stack-trace filter (journal 0096;
# Documentation/fault-injection/fault-injection.rst). Nothing fails unless a test arms it.
CONFIG_DEBUG_FS=y
CONFIG_STACKTRACE=y
# R2-10 regression synchronizes directory removal with an observed scan call.
CONFIG_FUNCTION_TRACER=y
CONFIG_FAULT_INJECTION=y
CONFIG_FAILSLAB=y
CONFIG_FAIL_PAGE_ALLOC=y
CONFIG_FAULT_INJECTION_DEBUG_FS=y
CONFIG_FAULT_INJECTION_STACKTRACE_FILTER=y
# Runtime hardening of security roadmap S8 (journal 0237), as Debian's 6.12 kernels build it,
# so the module is compiled and run under the checks a distribution kernel makes: fortified
# str/mem functions, usercopy bounds, hardened slab freelists, BUG on list corruption, KFENCE
# sampling (default 100 ms interval), stack-end check, and object-lifetime tracking of
# rcu_heads and freed objects. init_on_alloc/init_on_free stay off here: zeroing memory would
# hide from the detectors the uninitialized state they found before (journal 0237); the
# Debian 6.12.113 job runs the whole suite with init_on_alloc=1.
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_KFENCE=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
